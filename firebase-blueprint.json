{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with personal certification goals and cloud learning telemetry",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "targetExam": { "type": "string", "maxLength": 64 },
        "targetExamTitle": { "type": "string", "maxLength": 120 },
        "targetDate": { "type": "string", "maxLength": 64 },
        "weeklyTarget": { "type": "number" },
        "streakDays": { "type": "number" },
        "questionsSolved": { "type": "number" },
        "averageScore": { "type": "number" },
        "readinessIndex": { "type": "number" },
        "preferredLanguage": { "type": "string", "maxLength": 8 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "email", "displayName", "targetExam"]
    },
    "CertificationProgress": {
      "title": "CertificationProgress",
      "description": "Detailed learning progression and domain mastery for an individual cloud certification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "certCode": { "type": "string", "maxLength": 32 },
        "progress": { "type": "number" },
        "score": { "type": "number" },
        "readinessIndex": { "type": "number" },
        "lastCardIndex": { "type": "number" },
        "reviewedCardsCount": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "certCode"]
    },
    "ExamAttempt": {
      "title": "ExamAttempt",
      "description": "Historical record of an exam or quiz attempt completed by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "examCode": { "type": "string", "maxLength": 32 },
        "examTitle": { "type": "string", "maxLength": 128 },
        "attemptNumber": { "type": "number" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "passed": { "type": "boolean" },
        "duration": { "type": "string", "maxLength": 32 },
        "weakPoint": { "type": "string", "maxLength": 128 },
        "domainScoresSummary": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "examCode", "score", "passed"]
    },
    "FlashcardReview": {
      "title": "FlashcardReview",
      "description": "Spaced repetition SM-2 review event recorded for a memo card",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "cardId": { "type": "string", "maxLength": 64 },
        "certCode": { "type": "string", "maxLength": 32 },
        "rating": { "type": "string", "maxLength": 32 },
        "intervalDays": { "type": "number" },
        "repetitions": { "type": "number" },
        "easeFactor": { "type": "number" },
        "difficulty": { "type": "number" },
        "totalReviews": { "type": "number" },
        "successReviews": { "type": "number" },
        "nextReviewDate": { "type": "string", "maxLength": 64 },
        "isBookmarked": { "type": "boolean" },
        "reviewedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "cardId", "rating"]
    },
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Authorized content audit administrator profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 32 },
        "active": { "type": "boolean" },
        "addedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "role", "active"]
    },
    "AuditContentState": {
      "title": "AuditContentState",
      "description": "Editorial workflow state, hash, version, and validation metadata for any indexed pedagogical content item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "contentType": { "type": "string", "maxLength": 32 },
        "certificationId": { "type": "string", "maxLength": 64 },
        "provider": { "type": "string", "maxLength": 32 },
        "editorialStatus": { "type": "string", "maxLength": 48 },
        "validationStatus": { "type": "string", "maxLength": 48 },
        "freshnessStatus": { "type": "string", "maxLength": 48 },
        "activeVersion": { "type": "number" },
        "contentHash": { "type": "string", "maxLength": 128 },
        "humanValidatedVersion": { "type": "number" },
        "lastAuditedAt": { "type": "string", "maxLength": 64 },
        "lastValidatedAt": { "type": "string", "maxLength": 64 },
        "lastValidatedBy": { "type": "string", "maxLength": 256 },
        "archived": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "contentType", "editorialStatus", "validationStatus", "activeVersion", "contentHash"]
    },
    "CertificationReference": {
      "title": "CertificationReference",
      "description": "Official certification lifecycle metadata, exam parameters, and retirement tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 160 },
        "provider": { "type": "string", "maxLength": 32 },
        "officialStatus": { "type": "string", "maxLength": 48 },
        "launchDate": { "type": "string", "maxLength": 64 },
        "deprecationAnnouncedDate": { "type": "string", "maxLength": 64 },
        "retirementDate": { "type": "string", "maxLength": 64 },
        "durationMinutes": { "type": "number" },
        "itemsCount": { "type": "number" },
        "passScore": { "type": "number" },
        "maxScore": { "type": "number" },
        "examPrice": { "type": "string", "maxLength": 64 },
        "languagesSummary": { "type": "string", "maxLength": 128 },
        "officialUrl": { "type": "string", "maxLength": 1024 },
        "domainWeightsSummary": { "type": "string", "maxLength": 2048 },
        "changeAlert": { "type": "string", "maxLength": 512 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "code", "title", "provider", "officialStatus"]
    },
    "SourceReference": {
      "title": "SourceReference",
      "description": "Official or supplementary documentation reference used to ground pedagogical claims",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 240 },
        "vendor": { "type": "string", "maxLength": 64 },
        "url": { "type": "string", "maxLength": 2048 },
        "finalUrl": { "type": "string", "maxLength": 2048 },
        "sourceType": { "type": "string", "maxLength": 48 },
        "priorityLevel": { "type": "number" },
        "availabilityStatus": { "type": "string", "maxLength": 48 },
        "httpStatus": { "type": "number" },
        "lastCheckedAt": { "type": "string", "maxLength": 64 },
        "lastModifiedHeader": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "title", "vendor", "url", "sourceType", "priorityLevel"]
    },
    "ContentEvidence": {
      "title": "ContentEvidence",
      "description": "Documented link between a pedagogical content item, claim, official source, and supporting excerpt",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "contentId": { "type": "string", "maxLength": 128 },
        "claimSummary": { "type": "string", "maxLength": 512 },
        "sourceId": { "type": "string", "maxLength": 128 },
        "sourceUrl": { "type": "string", "maxLength": 2048 },
        "excerpt": { "type": "string", "maxLength": 4096 },
        "supportsClaim": { "type": "boolean" },
        "verifiedAt": { "type": "string", "maxLength": 64 },
        "verifiedBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "contentId", "sourceId", "claimSummary"]
    },
    "AuditRun": {
      "title": "AuditRun",
      "description": "Execution trace of deterministic and/or AI-assisted content audit batch",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "scopeType": { "type": "string", "maxLength": 48 },
        "scopeLabel": { "type": "string", "maxLength": 240 },
        "targetCount": { "type": "number" },
        "completedCount": { "type": "number" },
        "findingsCount": { "type": "number" },
        "modelIdentifier": { "type": "string", "maxLength": 128 },
        "promptVersion": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 32 },
        "startedAt": { "type": "string", "maxLength": 64 },
        "completedAt": { "type": "string", "maxLength": 64 },
        "initiatedBy": { "type": "string", "maxLength": 256 },
        "summary": { "type": "string", "maxLength": 1024 }
      },
      "required": ["id", "scopeType", "status", "startedAt", "initiatedBy"]
    },
    "AuditFinding": {
      "title": "AuditFinding",
      "description": "Structured anomaly or verification alert raised for a specific content version",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "runId": { "type": "string", "maxLength": 128 },
        "contentId": { "type": "string", "maxLength": 128 },
        "contentType": { "type": "string", "maxLength": 32 },
        "contentVersion": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "severity": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "maxLength": 48 },
        "title": { "type": "string", "maxLength": 240 },
        "rationale": { "type": "string", "maxLength": 2048 },
        "problematicExcerpt": { "type": "string", "maxLength": 1024 },
        "recommendedAction": { "type": "string", "maxLength": 1024 },
        "sourceBasis": { "type": "string", "maxLength": 512 },
        "needsHumanConfirmation": { "type": "boolean" },
        "origin": { "type": "string", "maxLength": 32 },
        "resolutionComment": { "type": "string", "maxLength": 1024 },
        "resolvedAt": { "type": "string", "maxLength": 64 },
        "resolvedBy": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "runId", "contentId", "category", "severity", "status", "title"]
    },
    "HumanReview": {
      "title": "HumanReview",
      "description": "Mandatory human editorial validation decision bound to a specific content version",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "contentId": { "type": "string", "maxLength": 128 },
        "contentVersion": { "type": "number" },
        "reviewerUid": { "type": "string", "maxLength": 128 },
        "reviewerEmail": { "type": "string", "maxLength": 256 },
        "decision": { "type": "string", "maxLength": 48 },
        "justification": { "type": "string", "maxLength": 2048 },
        "conditionalReserves": { "type": "string", "maxLength": 1024 },
        "attachedSourceIdsJson": { "type": "string", "maxLength": 1024 },
        "reviewedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "contentId", "contentVersion", "reviewerUid", "decision", "reviewedAt"]
    },
    "ContentRevision": {
      "title": "ContentRevision",
      "description": "Immutable versioned content snapshot and diff history",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "contentId": { "type": "string", "maxLength": 128 },
        "versionNumber": { "type": "number" },
        "contentHash": { "type": "string", "maxLength": 128 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorEmail": { "type": "string", "maxLength": 256 },
        "changeNote": { "type": "string", "maxLength": 512 },
        "diffSummary": { "type": "string", "maxLength": 4096 },
        "snapshotJson": { "type": "string", "maxLength": 32768 },
        "invalidatesPriorValidation": { "type": "boolean" },
        "restoredFromVersion": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "contentId", "versionNumber", "contentHash", "authorUid", "createdAt"]
    },
    "AuditSettings": {
      "title": "AuditSettings",
      "description": "Global content audit operational parameters, AI budget caps, and freshness window",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "activeAiModel": { "type": "string", "maxLength": 128 },
        "promptVersion": { "type": "string", "maxLength": 64 },
        "freshnessMaxDays": { "type": "number" },
        "dailyAiCallCap": { "type": "number" },
        "maxBatchSize": { "type": "number" },
        "requireOfficialSourceForApproval": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "activeAiModel", "freshnessMaxDays", "dailyAiCallCap"]
    },
    "PublishedContentOverride": {
      "title": "PublishedContentOverride",
      "description": "Human-validated live content patch or deprecation notice exposed to learners",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "contentType": { "type": "string", "maxLength": 32 },
        "approvedVersion": { "type": "number" },
        "approvedBy": { "type": "string", "maxLength": 256 },
        "approvedAt": { "type": "string", "maxLength": 64 },
        "patchJson": { "type": "string", "maxLength": 32768 },
        "isArchived": { "type": "boolean" }
      },
      "required": ["id", "contentType", "approvedVersion", "approvedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user learning profile, target certification, and telemetry"
    },
    "/users/{userId}/certifications/{certId}": {
      "schema": "CertificationProgress",
      "description": "Subcollection of per-certification progress, scores, and saved card indexes"
    },
    "/users/{userId}/attempts/{attemptId}": {
      "schema": "ExamAttempt",
      "description": "Subcollection of exam simulations and score records for the user"
    },
    "/users/{userId}/reviews/{reviewId}": {
      "schema": "FlashcardReview",
      "description": "Subcollection of spaced repetition card reviews for the user"
    },
    "/admins/{uid}": {
      "schema": "AdminAccount",
      "description": "Admin authorization roster (admin read/write only)"
    },
    "/auditContentState/{contentId}": {
      "schema": "AuditContentState",
      "description": "Editorial workflow and validation state per content item"
    },
    "/auditCertifications/{certId}": {
      "schema": "CertificationReference",
      "description": "Official certification lifecycle and blueprint reference records"
    },
    "/auditSources/{sourceId}": {
      "schema": "SourceReference",
      "description": "Registry of official vendor documentation and sources"
    },
    "/auditEvidence/{evidenceId}": {
      "schema": "ContentEvidence",
      "description": "Supporting excerpts linking claims to verified sources"
    },
    "/auditRuns/{runId}": {
      "schema": "AuditRun",
      "description": "Execution history of deterministic and AI content audits"
    },
    "/auditFindings/{findingId}": {
      "schema": "AuditFinding",
      "description": "Persistent findings and historical anomalies"
    },
    "/auditReviews/{reviewId}": {
      "schema": "HumanReview",
      "description": "Human validation decisions tied to content versions"
    },
    "/auditRevisions/{revisionId}": {
      "schema": "ContentRevision",
      "description": "Immutable content revision history and snapshots"
    },
    "/auditSettings/{settingId}": {
      "schema": "AuditSettings",
      "description": "Global audit operational configuration"
    },
    "/publishedContent/{contentId}": {
      "schema": "PublishedContentOverride",
      "description": "Human-approved published content overrides and status banners for learners"
    }
  }
}
